DATABASE_URL="postgresql://kanban_app:password@localhost:5432/kanban?schema=public"
# 結合テスト用（`docker compose up -d test-db` の後、`npm run test:integration`）。
# DB名に"test"を含めない値を入れると起動時にエラーになる（開発DBを誤って対象にする事故防止のガード）。
TEST_DATABASE_URL="postgresql://kanban_app:password@localhost:5433/kanban_test?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
GEMINI_API_KEY="your-gemini-api-key"
# 期限切れゲストの自動削除APIを保護するシークレット（cron からの呼び出し用）
CRON_SECRET="generate-with-openssl-rand-base64-32"
